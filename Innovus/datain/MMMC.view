create_rc_corner -name SlowRC -T {125} \
    -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} \
    -postRoute_res {1} -postRoute_cap {1} -postRoute_xcap {1} \
    -postRoute_clkres {0} -postRoute_clkcap {0}

create_rc_corner -name FastRC -T {-40} \
    -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} \
    -postRoute_res {1} -postRoute_cap {1} -postRoute_xcap {1} \
    -postRoute_clkres {0} -postRoute_clkcap {0}

create_library_set -name Typ -timing {
